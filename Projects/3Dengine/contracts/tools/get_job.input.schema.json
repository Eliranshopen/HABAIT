{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "get_job input",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$",
      "description": "The 16-hex job id from start_simulation or list_jobs."
