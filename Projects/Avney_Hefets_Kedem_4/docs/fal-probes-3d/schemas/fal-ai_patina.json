{"openapi": "3.1.0", "info": {"title": "Queue OpenAPI for fal-ai/patina", "version": "1.0.0", "description": "The OpenAPI schema for the fal-ai/patina queue.", "x-fal-metadata": {"endpointId": "fal-ai/patina", "category": "image-to-image", "thumbnailUrl": "https://v3b.fal.media/files/b/0a9596de/rM98s4o9rBuzShY5_OvHz_50bff4e15999429a8c8c68fa8d931c5d.jpg", "playgroundUrl": "https://fal.ai/models/fal-ai/patina", "documentationUrl": "https://fal.ai/models/fal-ai/patina/api", "about": "Predict PBR material maps from a single input image."}}, "components": {"securitySchemes": {"apiKeyAuth": {"type": "apiKey", "in": "header", "name": "Authorization", "description": "Fal Key"}}, "schemas": {"QueueStatus": {"type": "object", "properties": {"status": {"type": "string", "enum": ["IN_QUEUE", "IN_PROGRESS", "COMPLETED"]}, "request_id": {"type": "string", "description": "The request id."}, "response_url": {"type": "string", "description": "The response url."}, "status_url": {"type": "string", "description": "The status url."}, "cancel_url": {"type": "string", "description": "The cancel url."}, "logs": {"type": "object", "description": "The logs.", "additionalProperties": true}, "metrics": {"type": "object", "description": "The metrics.", "additionalProperties": true}, "queue_position": {"type": "integer", "description": "The queue position."}}, "required": ["status", "request_id"]}, "PatinaInput": {"x-fal-order-properties": ["image_url", "maps", "seed", "sync_mode", "enable_safety_checker", "output_format"], "required": ["image_url"], "title": "PatinaInput", "type": "object", "properties": {"image_url": {"description": "URL of the input image (photograph or render).", "title": "Image URL", "examples": ["https://storage.googleapis.com/falserverless/gallery/patina-blog-hero-render.png"], "type": "string"}, "output_format": {"description": "Output image format.", "title": "Output Format", "type": "string", "enum": ["jpeg", "png", "webp"], "default": "png"}, "seed": {"description": "Random seed for reproducible denoising. If not set, a random seed is used.", "title": "Seed", "anyOf": [{"type": "integer"}, {"type": "null"}]}, "sync_mode": {"description": "If True, return images as data URIs instead of CDN URLs.", "title": "Sync Mode", "type": "boolean", "default": false}, "enable_safety_checker": {"description": "Enable the safety checker for images.", "title": "Enable Safety Checker", "type": "boolean", "default": true}, "maps": {"items": {"type": "string", "enum": ["basecolor", "normal", "roughness", "metalness", "height"]}, "description": "Which PBR maps to predict. Defaults to all five.", "title": "Maps", "type": "array", "default": ["basecolor", "normal", "roughness", "metalness", "height"]}}}, "PatinaOutput": {"x-fal-order-properties": ["images", "timings", "seed"], "required": ["images", "seed"], "title": "PatinaOutput", "type": "object", "properties": {"seed": {"description": "The seed used for denoising.", "title": "Seed", "type": "integer"}, "timings": {"additionalProperties": {"type": "number"}, "description": "Timing breakdown (seconds).", "title": "Timings", "type": "object"}, "images": {"items": {"$ref": "#/components/schemas/MapImageFile"}, "description": "Predicted PBR material maps.", "title": "Images", "examples": [[{"map_type": "basecolor", "url": "https://storage.googleapis.com/falserverless/gallery/patina-blog-hero-basecolor.png"}, {"map_type": "normal", "url": "https://storage.googleapis.com/falserverless/gallery/patina-blog-hero-normal.png"}, {"map_type": "roughness", "url": "https://storage.googleapis.com/falserverless/gallery/patina-blog-hero-roughness.png"}, {"map_type": "metalness", "url": "https://storage.googleapis.com/falserverless/gallery/patina-blog-hero-metalness.png"}, {"map_type": "height", "url": "https://storage.googleapis.com/falserverless/gallery/patina-blog-hero-height.png"}]], "type": "array"}}}, "MapImageFile": {"x-fal-order-properties": ["url", "content_type", "file_name", "file_size", "width", "height", "map_type"], "required": ["url", "map_type"], "title": "MapImageFile", "type": "object", "properties": {"height": {"description": "The height of the image", "title": "Height", "anyOf": [{"type": "integer"}, {"type": "null"}]}, "content_type": {"description": "The mime type of the file.", "title": "Content Type", "examples": ["image/png"], "anyOf": [{"type": "string"}, {"type": "null"}]}, "width": {"description": "The width of the image", "title": "Width", "anyOf": [{"type": "integer"}, {"type": "null"}]}, "file_size": {"description": "The size of the file in bytes.", "title": "File Size", "examples": [4404019], "anyOf": [{"type": "integer"}, {"type": "null"}]}, "map_type": {"description": "Which PBR map this image represents.", "title": "Map Type", "type": "string", "enum": ["basecolor", "normal", "roughness", "metalness", "height"]}, "file_name": {"description": "The name of the file. It will be auto-generated if not provided.", "title": "File Name", "examples": ["z9RV14K95DvU.png"], "anyOf": [{"type": "string"}, {"type": "null"}]}, "url": {"description": "The URL where the file can be downloaded from.", "title": "Url", "type": "string"}}}}}, "paths": {"/fal-ai/patina/requests/{request_id}/status": {"get": {"parameters": [{"name": "request_id", "in": "path", "required": true, "schema": {"type": "string", "description": "Request ID"}}, {"name": "logs", "in": "query", "required": false, "schema": {"type": "number", "description": "Whether to include logs (`1`) in the response or not (`0`)."}}], "responses": {"200": {"description": "The request status.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/QueueStatus"}}}}}}}, "/fal-ai/patina/requests/{request_id}/cancel": {"put": {"parameters": [{"name": "request_id", "in": "path", "required": true, "schema": {"type": "string", "description": "Request ID"}}], "responses": {"200": {"description": "The request was cancelled.", "content": {"application/json": {"schema": {"type": "object", "properties": {"success": {"type": "boolean", "description": "Whether the request was cancelled successfully."}}}}}}}}}, "/fal-ai/patina": {"post": {"requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PatinaInput"}}}}, "responses": {"200": {"description": "The request status.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/QueueStatus"}}}}}}}, "/fal-ai/patina/requests/{request_id}": {"get": {"parameters": [{"name": "request_id", "in": "path", "required": true, "schema": {"type": "string", "description": "Request ID"}}], "responses": {"200": {"description": "Result of the request.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PatinaOutput"}}}}}}}}, "servers": [{"url": "https://queue.fal.run"}], "security": [{"apiKeyAuth": []}]}