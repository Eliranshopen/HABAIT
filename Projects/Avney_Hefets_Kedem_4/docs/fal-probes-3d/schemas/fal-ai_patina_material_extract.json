{"openapi": "3.1.0", "info": {"title": "Queue OpenAPI for fal-ai/patina/material/extract", "version": "1.0.0", "description": "The OpenAPI schema for the fal-ai/patina/material/extract queue.", "x-fal-metadata": {"endpointId": "fal-ai/patina/material/extract", "category": "image-to-image", "thumbnailUrl": "https://v3b.fal.media/files/b/0a9596fb/hGlZRKSg6METXKPyJr-7D_7152ffc4674342699bff539ff28f7d77.jpg", "playgroundUrl": "https://fal.ai/models/fal-ai/patina/material/extract", "documentationUrl": "https://fal.ai/models/fal-ai/patina/material/extract/api", "about": "Extract a texture from an image and generate a complete PBR material."}}, "components": {"securitySchemes": {"apiKeyAuth": {"type": "apiKey", "in": "header", "name": "Authorization", "description": "Fal Key"}}, "schemas": {"QueueStatus": {"type": "object", "properties": {"status": {"type": "string", "enum": ["IN_QUEUE", "IN_PROGRESS", "COMPLETED"]}, "request_id": {"type": "string", "description": "The request id."}, "response_url": {"type": "string", "description": "The response url."}, "status_url": {"type": "string", "description": "The status url."}, "cancel_url": {"type": "string", "description": "The cancel url."}, "logs": {"type": "object", "description": "The logs.", "additionalProperties": true}, "metrics": {"type": "object", "description": "The metrics.", "additionalProperties": true}, "queue_position": {"type": "integer", "description": "The queue position."}}, "required": ["status", "request_id"]}, "PatinaMaterialExtractInput": {"title": "ExtractTextureInput", "type": "object", "x-fal-order-properties": ["prompt", "image_size", "num_inference_steps", "seed", "num_images", "enable_prompt_expansion", "enable_safety_checker", "tiling_mode", "tile_size", "tile_stride", "image_url", "strength", "maps", "upscale_factor", "output_format"], "required": ["prompt", "image_url"], "properties": {"enable_prompt_expansion": {"title": "Enable Prompt Expansion", "type": "boolean", "default": true, "description": "Expand prompt with an LLM for richer detail. Adds ~0.0025 credits."}, "upscale_factor": {"title": "Upscale Factor", "type": "integer", "enum": [0, 2, 4], "description": "Upscale factor for predicted PBR maps via SeedVR seamless upscaling. 0 = no upscaling, 2 = 2\u00d7 resolution, 4 = 4\u00d7 resolution. The base texture image is not upscaled.", "default": 0}, "tiling_mode": {"title": "Tiling Mode", "type": "string", "enum": ["both", "horizontal", "vertical"], "description": "Tiling direction: 'both' (omnidirectional), 'horizontal', or 'vertical'.", "default": "both"}, "tile_size": {"multipleOf": 2, "type": "integer", "title": "Tile Size", "description": "Tile size in latent space. Automatically capped to the generated image dimensions on tiled axes (64 = 512px, 128 = 1024px).", "default": 128, "maximum": 256, "minimum": 32}, "enable_safety_checker": {"title": "Enable Safety Checker", "type": "boolean", "default": true, "description": "Enable the safety checker for generated images."}, "num_images": {"title": "Number of Images", "type": "integer", "default": 1, "description": "Number of texture images to generate.", "maximum": 4, "minimum": 1}, "num_inference_steps": {"title": "Number of Inference Steps", "type": "integer", "default": 8, "description": "Number of denoising steps for texture generation.", "maximum": 8, "minimum": 1}, "seed": {"title": "Seed", "description": "Random seed for reproducible generation.", "anyOf": [{"type": "integer"}, {"type": "null"}]}, "maps": {"title": "Maps", "type": "array", "default": ["basecolor", "normal", "roughness", "metalness", "height"], "description": "Which PBR maps to predict. Deselect all to skip PBR estimation entirely. Defaults to all five.", "items": {"type": "string", "enum": ["basecolor", "normal", "roughness", "metalness", "height"]}}, "strength": {"title": "Strength", "type": "number", "default": 0.6, "description": "How much to transform the input image. Only used when image_url is provided.", "maximum": 1, "exclusiveMinimum": 0}, "prompt": {"title": "Prompt", "type": "string", "description": "Describe which texture to extract from the image.", "examples": ["the wall"]}, "output_format": {"title": "Output Format", "type": "string", "enum": ["jpeg", "png", "webp"], "description": "Output image format for textures and PBR maps.", "default": "png"}, "image_size": {"title": "Image Size", "default": "square_hd", "description": "Output texture dimensions in pixels.", "anyOf": [{"$ref": "#/components/schemas/ImageSize"}, {"type": "string", "enum": ["square_hd", "square", "portrait_4_3", "portrait_16_9", "landscape_4_3", "landscape_16_9"]}]}, "tile_stride": {"multipleOf": 2, "type": "integer", "title": "Tile Stride", "description": "Tile stride in latent space. Automatically capped to half the effective tile size.", "default": 64, "maximum": 128, "minimum": 16}, "image_url": {"title": "Image URL", "type": "string", "description": "URL of the image to extract a texture from.", "examples": ["https://v3b.fal.media/files/b/0a95600b/IVhCXWN-sE1xj1SpYAGpL_31b6f371-90ae-4835-851e-23cd809cfb86.png"]}}}, "PatinaMaterialExtractOutput": {"title": "ExtractTextureOutput", "type": "object", "x-fal-order-properties": ["images", "seed", "prompt", "timings"], "required": ["images", "seed", "prompt"], "properties": {"prompt": {"title": "Prompt", "type": "string", "description": "The prompt used for texture generation (possibly expanded)."}, "images": {"title": "Images", "type": "array", "items": {"anyOf": [{"$ref": "#/components/schemas/ImageFile"}, {"$ref": "#/components/schemas/MapImageFile"}]}, "description": "Generated tileable texture image(s) from z-image and predicted PBR material maps from PATINA.", "examples": [[{"url": "https://v3b.fal.media/files/b/0a95600e/XOK8IGCqq5rxcf7qf_aGU_R70gdMA6.png"}, {"url": "https://v3b.fal.media/files/b/0a95600f/BDo24MQ7U-QzwGe1p6VA0_GnbTunKU.png", "map_type": "basecolor"}, {"url": "https://v3b.fal.media/files/b/0a95600f/Q1YXkdLWthiwxQgiZJCIT_8WLMkQ03.png",