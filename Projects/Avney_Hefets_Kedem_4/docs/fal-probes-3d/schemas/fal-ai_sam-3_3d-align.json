{"openapi": "3.1.0", "info": {"title": "Queue OpenAPI for fal-ai/sam-3/3d-align", "version": "1.0.0", "description": "The OpenAPI schema for the fal-ai/sam-3/3d-align queue.", "x-fal-metadata": {"endpointId": "fal-ai/sam-3/3d-align", "category": "3d-to-3d", "thumbnailUrl": "https://v3b.fal.media/files/b/0a84bb71/k2b6czMQphI5lV6zjLj8z_ea2a892775d745b08a01ba6ecfa6ca43.jpg", "playgroundUrl": "https://fal.ai/models/fal-ai/sam-3/3d-align", "documentationUrl": "https://fal.ai/models/fal-ai/sam-3/3d-align/api", "about": "Align a SAM-3D Body mesh to MoGe/SAM-3D Objects coordinate frame for scene composition."}}, "components": {"securitySchemes": {"apiKeyAuth": {"type": "apiKey", "in": "header", "name": "Authorization", "description": "Fal Key"}}, "schemas": {"QueueStatus": {"type": "object", "properties": {"status": {"type": "string", "enum": ["IN_QUEUE", "IN_PROGRESS", "COMPLETED"]}, "request_id": {"type": "string", "description": "The request id."}, "response_url": {"type": "string", "description": "The response url."}, "status_url": {"type": "string", "description": "The status url."}, "cancel_url": {"type": "string", "description": "The cancel url."}, "logs": {"type": "object", "description": "The logs.", "additionalProperties": true}, "metrics": {"type": "object", "description": "The metrics.", "additionalProperties": true}, "queue_position": {"type": "integer", "description": "The queue position."}}, "required": ["status", "request_id"]}, "Sam33dAlignInput": {"type": "object", "title": "SAM3DAlignmentInput", "x-fal-order-properties": ["image_url", "body_mesh_url", "body_mask_url", "object_mesh_url", "focal_length"], "properties": {"image_url": {"type": "string", "description": "URL of the original image used for MoGe depth estimation", "title": "Image Url"}, "object_mesh_url": {"description": "Optional URL of SAM-3D Object mesh (.glb) to create combined scene", "anyOf": [{"type": "string"}, {"type": "null"}], "title": "Object Mesh Url"}, "focal_length": {"description": "Focal length from SAM-3D Body metadata. If not provided, estimated from MoGe.", "anyOf": [{"type": "number"}, {"type": "null"}], "title": "Focal Length"}, "body_mask_url": {"description": "URL of the human mask image. If not provided, uses full image.", "anyOf": [{"type": "string"}, {"type": "null"}], "title": "Body Mask Url"}, "body_mesh_url": {"type": "string", "description": "URL of the SAM-3D Body mesh file (.ply or .glb) to align", "title": "Body Mesh Url"}}, "required": ["image_url", "body_mesh_url"]}, "Sam33dAlignOutput": {"type": "object", "title": "SAM3DAlignmentOutput", "x-fal-order-properties": ["body_mesh_ply", "model_glb", "visualization", "metadata", "scene_glb"], "properties": {"metadata": {"description": "Alignment info (scale, translation, etc.)", "$ref": "#/components/schemas/SAM3DBodyAlignmentInfo"}, "scene_glb": {"description": "Combined scene with body + object meshes in GLB format (only when object_mesh_url provided)", "anyOf": [{"$ref": "#/components/schemas/File"}, {"type": "null"}]}, "visualization": {"description": "Visualization of aligned mesh overlaid on input image", "$ref": "#/components/schemas/File"}, "body_mesh_ply": {"description": "Aligned body mesh in PLY format", "$ref": "#/components/schemas/File"}, "model_glb": {"description": "Aligned body mesh in GLB format (for 3D preview)", "$ref": "#/components/schemas/File"}}, "required": ["body_mesh_ply", "model_glb", "visualization", "metadata"]}, "SAM3DBodyAlignmentInfo": {"type": "object", "description": "Per-person alignment metadata.", "title": "SAM3DBodyAlignmentInfo", "x-fal-order-properties": ["person_id", "scale_factor", "translation", "focal_length", "target_points_count", "cropped_vertices_count"], "properties": {"target_points_count": {"type": "integer", "description": "Number of target points for alignment", "title": "Target Points Count"}, "focal_length": {"type": "number", "description": "Focal length used", "title": "Focal Length"}, "translation": {"items": {"type": "number"}, "type": "array", "description": "Translation [tx, ty, tz]", "title": "Translation"}, "person_id": {"type": "integer", "description": "Index of the person", "title": "Person Id"}, "scale_factor": {"type": "number", "description": "Scale factor applied for alignment", "title": "Scale Factor"}, "cropped_vertices_count": {"type": "integer", "description": "Number of cropped vertices", "title": "Cropped Vertices Count"}}, "required": ["person_id", "scale_factor", "translation", "focal_length", "target_points_count", "cropped_vertices_count"]}, "File": {"type": "object", "title": "File", "x-fal-order-properties": ["url", "content_type", "file_name", "file_size"], "properties": {"file_name": {"examples": ["z9RV14K95DvU.png"], "description": "The name of the file. It will be auto-generated if not provided.", "anyOf": [{"type": "string"}, {"type": "null"}], "title": "File Name"}, "content_type": {"examples": ["image/png"], "description": "The mime type of the file.", "anyOf": [{"type": "string"}, {"type": "null"}], "title": "Content Type"}, "file_size": {"examples": [4404019], "description": "The size of the file in bytes.", "anyOf": [{"type": "integer"}, {"type": "null"}], "title": "File Size"}, "url": {"type": "string", "description": "The URL where the file can be downloaded from.", "title": "Url"}}, "required": ["url"]}}}, "paths": {"/fal-ai/sam-3/3d-align/requests/{request_id}/status": {"get": {"parameters": [{"name": "request_id", "in": "path", "required": true, "schema": {"type": "string", "description": "Request ID"}}, {"name": "logs", "in": "query", "required": false, "schema": {"type": "number", "description": "Whether to include logs (`1`) in the response or not (`0`)."}}], "responses": {"200": {"description": "The request status.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/QueueStatus"}}}}}}}, "/fal-ai/sam-3/3d-align/requests/{request_id}/cancel": {"put": {"parameters": [{"name": "request_id", "in": "path", "required": true, "schema": {"type": "string", "description": "Request ID"}}], "responses": {"200": {"description": "The request was cancelled.", "content": {"application/json": {"schema": {"type": "object", "properties": {"success": {"type": "boolean", "description": "Whether the request was cancelled successfully."}}}}}}}}}, "/fal-ai/sam-3/3d-align": {"post": {"requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Sam33dAlignInput"}}}}, "responses": {"200": {"description": "The request status.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/QueueStatus"}}}}}}}, "/fal-ai/sam-3/3d-align/requests/{request_id}": {"get": {"parameters": [{"name": "request_id", "in": "path", "required": true, "schema": {"type": "string", "description": "Request ID"}}], "responses": {"200": {"description": "Result of the request.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Sam33dAlignOutput"}}}}}}}}, "servers": [{"url": "https://queue.fal.run"}], "security": [{"apiKeyAuth": []}]}