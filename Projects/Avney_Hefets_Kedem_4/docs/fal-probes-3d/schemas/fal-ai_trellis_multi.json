{"openapi": "3.1.0", "info": {"title": "Queue OpenAPI for fal-ai/trellis/multi", "version": "1.0.0", "description": "The OpenAPI schema for the fal-ai/trellis/multi queue.", "x-fal-metadata": {"endpointId": "fal-ai/trellis/multi", "category": "image-to-3d", "thumbnailUrl": "https://storage.googleapis.com/fal_cdn/fal/Training.jpg", "playgroundUrl": "https://fal.ai/models/fal-ai/trellis/multi", "documentationUrl": "https://fal.ai/models/fal-ai/trellis/multi/api", "about": "Generate Multi"}}, "components": {"securitySchemes": {"apiKeyAuth": {"type": "apiKey", "in": "header", "name": "Authorization", "description": "Fal Key"}}, "schemas": {"QueueStatus": {"type": "object", "properties": {"status": {"type": "string", "enum": ["IN_QUEUE", "IN_PROGRESS", "COMPLETED"]}, "request_id": {"type": "string", "description": "The request id."}, "response_url": {"type": "string", "description": "The response url."}, "status_url": {"type": "string", "description": "The status url."}, "cancel_url": {"type": "string", "description": "The cancel url."}, "logs": {"type": "object", "description": "The logs.", "additionalProperties": true}, "metrics": {"type": "object", "description": "The metrics.", "additionalProperties": true}, "queue_position": {"type": "integer", "description": "The queue position."}}, "required": ["status", "request_id"]}, "TrellisMultiInput": {"type": "object", "required": ["image_urls"], "x-fal-order-properties": ["image_urls", "seed", "ss_guidance_strength", "ss_sampling_steps", "slat_guidance_strength", "slat_sampling_steps", "mesh_simplify", "texture_size", "multiimage_algo"], "properties": {"mesh_simplify": {"type": "number", "default": 0.95, "minimum": 0.9, "maximum": 0.98, "description": "Mesh simplification factor", "title": "Mesh Simplify"}, "ss_sampling_steps": {"type": "integer", "default": 12, "minimum": 1, "maximum": 50, "description": "Sampling steps for sparse structure generation", "title": "Ss Sampling Steps"}, "ss_guidance_strength": {"type": "number", "default": 7.5, "minimum": 0, "maximum": 10, "description": "Guidance strength for sparse structure generation", "title": "Ss Guidance Strength"}, "multiimage_algo": {"type": "string", "default": "stochastic", "enum": ["stochastic", "multidiffusion"], "description": "Algorithm for multi-image generation", "title": "Multiimage Algo"}, "slat_guidance_strength": {"type": "number", "default": 3, "minimum": 0, "maximum": 10, "description": "Guidance strength for structured latent generation", "title": "Slat Guidance Strength"}, "texture_size": {"type": "integer", "default": 1024, "enum": [512, 1024, 2048], "description": "Texture resolution", "title": "Texture Size"}, "slat_sampling_steps": {"type": "integer", "default": 12, "minimum": 1, "maximum": 50, "description": "Sampling steps for structured latent generation", "title": "Slat Sampling Steps"}, "seed": {"anyOf": [{"type": "integer"}, {"type": "null"}], "description": "Random seed for reproducibility", "title": "Seed"}, "image_urls": {"type": "array", "examples": [["https://storage.googleapis.com/falserverless/model_tests/video_models/front.png", "https://storage.googleapis.com/falserverless/model_tests/video_models/back.png", "https://storage.googleapis.com/falserverless/model_tests/video_models/left.png"]], "maxItems": 8, "items": {"type": "string"}, "description": "List of URLs of input images to convert to 3D (maximum 8).", "minItems": 1, "title": "Image Urls"}}, "title": "MultiImageInputModel"}, "TrellisMultiOutput": {"type": "object", "required": ["model_mesh", "timings"], "x-fal-order-properties": ["model_mesh", "timings"], "properties": {"timings": {"type": "object", "additionalProperties": {"type": "number"}, "description": "Processing timings", "title": "Timings"}, "model_mesh": {"$ref": "#/components/schemas/File", "description": "Generated 3D mesh file"}}, "title": "ObjectOutput"}, "File": {"type": "object", "required": ["url"], "x-fal-order-properties": ["url", "content_type", "file_name", "file_size"], "properties": {"content_type": {"anyOf": [{"type": "string"}, {"type": "null"}], "examples": ["image/png"], "description": "The mime type of the file.", "title": "Content Type"}, "file_size": {"anyOf": [{"type": "integer"}, {"type": "null"}], "examples": [4404019], "description": "The size of the file in bytes.", "title": "File Size"}, "file_name": {"anyOf": [{"type": "string"}, {"type": "null"}], "examples": ["z9RV14K95DvU.png"], "description": "The name of the file. It will be auto-generated if not provided.", "title": "File Name"}, "url": {"type": "string", "description": "The URL where the file can be downloaded from.", "title": "Url"}}, "title": "File"}}}, "paths": {"/fal-ai/trellis/multi/requests/{request_id}/status": {"get": {"parameters": [{"name": "request_id", "in": "path", "required": true, "schema": {"type": "string", "description": "Request ID"}}, {"name": "logs", "in": "query", "required": false, "schema": {"type": "number", "description": "Whether to include logs (`1`) in the response or not (`0`)."}}], "responses": {"200": {"description": "The request status.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/QueueStatus"}}}}}}}, "/fal-ai/trellis/multi/requests/{request_id}/cancel": {"put": {"parameters": [{"name": "request_id", "in": "path", "required": true, "schema": {"type": "string", "description": "Request ID"}}], "responses": {"200": {"description": "The request was cancelled.", "content": {"application/json": {"schema": {"type": "object", "properties": {"success": {"type": "boolean", "description": "Whether the request was cancelled successfully."}}}}}}}}}, "/fal-ai/trellis/multi": {"post": {"requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TrellisMultiInput"}}}}, "responses": {"200": {"description": "The request status.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/QueueStatus"}}}}}}}, "/fal-ai/trellis/multi/requests/{reques