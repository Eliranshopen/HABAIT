{"openapi": "3.1.0", "info": {"title": "Queue OpenAPI for meshy/v7/retexture", "version": "1.0.0", "description": "Upload a 3D model (.glb, .gltf, .obj, .fbx or .stl, as a URL or base64 data URI) and describe the texture you want in up to 600 characters, or provide a reference image (.jpg, .jpeg or .png). If both are provided, the image is used. The original UV mapping is kept by default; turn it off to generate new UVs. Optionally generate PBR maps (metallic, roughness, normal) in addition to base color. Returns a GLB model, other available formats, texture files and a preview thumbnail. Safety checking is enabled by default.", "x-fal-metadata": {"endpointId": "meshy/v7/retexture", "category": "3d-to-3d", "thumbnailUrl": "https://v3b.fal.media/files/b/0aae5f49/fX6rQr3MLd0HuSBFcnFRk.jpg", "playgroundUrl": "https://fal.ai/models/meshy/v7/retexture", "documentationUrl": "https://fal.ai/models/meshy/v7/retexture/api", "about": "Retexture using Meshy 7 with 2k, 4k, or 8k textures."}}, "components": {"securitySchemes": {"apiKeyAuth": {"type": "apiKey", "in": "header", "name": "Authorization", "description": "Fal Key"}}, "schemas": {"QueueStatus": {"type": "object", "properties": {"status": {"type": "string", "enum": ["IN_QUEUE", "IN_PROGRESS", "COMPLETED"]}, "request_id": {"type": "string", "description": "The request id."}, "response_url": {"type": "string", "description": "The response url."}, "status_url": {"type": "string", "description": "The status url."}, "cancel_url": {"type": "string", "description": "The cancel url."}, "logs": {"type": "object", "description": "The logs.", "additionalProperties": true}, "metrics": {"type": "object", "description": "The metrics.", "additionalProperties": true}, "queue_position": {"type": "integer", "description": "The queue position."}}, "required": ["status", "request_id"]}, "V7RetextureInput": {"properties": {"enable_safety_checker": {"description": "If set to true, input data will be checked for safety before processing.", "title": "Enable Safety Checker", "type": "boolean", "default": true}, "text_style_prompt": {"anyOf": [{"maxLength": 800, "type": "string"}, {"type": "null"}], "examples": ["red and black chest"], "title": "Text Style Prompt", "description": "Describe your desired texture style using text. Maximum 800 characters. Required if image_style_url is not provided."}, "enable_original_uv": {"description": "Use the original UV mapping of the model instead of generating new UVs. If the model has no original UV, output quality may be reduced.", "title": "Enable Original Uv", "type": "boolean", "default": true}, "image_style_url": {"anyOf": [{"type": "string", "ui": {"field": "image"}}, {"type": "null"}], "max_file_size": 20971520, "title": "Image Style Url", "max_pixels": 178956970, "description": "2D image to guide the texturing process. Supports .jpg, .jpeg, .png, and .webp formats. Required if text_style_prompt is not provided. If both are provided, image_style_url takes precedence."}, "model_url": {"description": "URL or base64 data URI of a 3D model to texture. Supports .glb, .gltf, .obj, .fbx, .stl formats. Can be a publicly accessible URL or data URI with MIME type application/octet-stream.", "examples": ["https://v3b.fal.media/files/b/penguin/DId89qXLu6BXu09RFAwAV_model.glb"], "title": "Model Url", "type": "string"}, "texture_resolution": {"description": "Base color resolution: 2k (2048), 4k (4096), or 8k (8192). 4k and 8k require Meshy 6 or 7. At 8k, PBR maps are 4k and no emission map is generated.", "title": "Texture Resolution", "type": "string", "default": "2k", "enum": ["2k", "4k", "8k"]}, "enable_pbr": {"description": "Generate PBR Maps (metallic, roughness, normal) in addition to base color.", "title": "Enable Pbr", "type": "boolean", "default": false}}, "description": "Input for 3D Model Retexturing", "title": "RetextureInput", "required": ["model_url"], "type": "object", "x-fal-order-properties": ["model_url", "text_style_prompt", "image_style_url", "texture_resolution", "enable_original_uv", "enable_pbr", "enable_safety_checker"]}, "V7RetextureOutput": {"properties": {"thumbnail": {"anyOf": [{"$ref": "#/components/schemas/File"}, {"type": "null"}], "examples": [{"content_type": "image/png", "file_size": 124859, "url": "https://v3b.fal.media/files/b/lion/jFrzgIJMbaPQi_4HCEa8u_preview.png", "file_name": "preview.png"}], "description": "Preview thumbnail of the retextured model"}, "text_style_prompt": {"anyOf": [{"type": "string"}, {"type": "null"}], "examples": ["red and black chest"], "title": "Text Style Prompt", "description": "The text prompt used for texturing (if provided)"}, "texture_urls": {"items": {"$ref": "#/components/schemas/TextureFiles"}, "description": "Array of texture file objects", "examples": [[{"base_color": {"content_type": "image/png", "file_size": 3455709, "url": "https://v3b.fal.media/files/b/zebra/opBcVy7AK-GOlCTUz-_GZ_texture_0.png", "file_name": "texture_0.png"}}]], "title": "Texture Urls", "type": "array"}, "image_style_url": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Image Style Url", "description": "The image URL used for texturing (if provided)"}, "model_glb": {"$ref": "#/components/schemas/File", "description": "Retextured 3D object in GLB format.", "examples": [{"content_type": "model/gltf-binary", "file_size": 4097640, "url": "https://v3b.fal.media/files/b/tiger/pU0TtsRTxXM6VnKEYTHSV_model.glb", "file_name": "model.glb"}]}, "model_urls": {"$ref": "#/components/schemas/ModelUrls", "description": "URLs for different 3D model formats", "examples": [{"fbx": {"content_type": "application/octet-stream", "file_size": 4713692, "url": "https://v3b.fal.media/files/b/rabbit/agzKf8N8zeVnteg72NiF4_model.fbx", "file_name": "model.fbx"}, "obj": {"content_type": "model/obj", "file_size": 2964508, "url": "https://v3b.fal.media/files/b/zebra/M5aK_b6vKH7KeGCZoSLq7_model.obj", "file_name": "model.obj"}, "usdz": {"content_type": "model/vnd.usdz+zip", "file_size": 3886518, "url": "https://v3b.fal.media/files/b/panda/4ItUhLHiH4foEw30qcWZv_model.usdz", "file_name": "model.usdz"}, "glb": {"content_type": "model/gltf-binary", "file_size": 4097640, "url": "https://v3b.fal.media/files/b/tiger/pU0TtsRTxXM6VnKEYTHSV_model.glb", "file_name": "model.glb"}}]}}, "description": "Output for 3D Model Retexturing", "title": "RetextureOutput", "required": ["model_glb", "model_urls"], "type": "object", "x-fal-order-properties": ["model_glb", "thumbnail", "model_urls", "texture_urls", "text_style_prompt", "image_style_url"]}, "File": {"properties": {"content_type": {"anyOf": [{"type": "string"}, {"type": "null"}], "examples": ["image/png"], "title": "Content Type", "description": "The mime type of the file."}, "file_size": {"anyOf": [{"type": "integer"}, {"type": "null"}], "examples": [4404019], "title": "File Size", "description": "The size of the file in bytes."}, "url": {"description": "The URL where the file can be downloaded from.", "title": "Url", "type": "string"}, "file_name": {"anyOf": [{"type": "string"}, {"type": "null"}], "examples": ["z9RV14K95DvU.png"], "title": "File Name", "description": "The name of the file. It will be auto-generated if not provided."}}, "required": ["url"], "title": "File", "type": "object", "x-fal-order-properties": ["url", "content_type", "file_name", "file_size"]}, "TextureFiles": {"properties": {"base_color": {"$ref": "#/components/schemas/File", "description": "Base color texture"}, "metallic": {"anyOf": [{"$ref": "#/components/schemas/File"}, {"type": "null"}], "description": "Metallic texture (PBR)"}, "normal": {"anyOf": [{"$ref": "#/components/schemas/File"}, {"type": "null"}], "description": "Normal texture (PBR)"}, "roughness": {"anyOf": [{"$ref": "#/components/schemas/File"}, {"type": "null"}], "description": "Roughness texture (PBR)"}}, "description": "Texture files downloaded and uploaded to CDN", "title": "TextureFiles", "required": ["base_color"], "type": "object", "x-fal-order-properties": ["base_color", "metallic", "normal", "roughness"]}, "ModelUrls": {"properties": {"fbx": {"anyOf": [{"$ref": "#/components/schemas/File"}, {"type": "null"}], "description": "FBX format 3D model"}, "obj": {"anyOf": [{"$ref": "#/components/schemas/File"}, {"type": "null"}], "description": "OBJ format 3D model"}, "blend": {"anyOf": [{"$ref": "#/components/schemas/File"}, {"type": "null"}], "description": "Blender format 3D model"}, "stl": {"anyOf": [{"$ref": "#/components/schemas/File"}, {"type": "null"}], "description": "STL format 3D model"}, "usdz": {"anyOf": [{"$ref": "#/components/schemas/File"}, {"type": "null"}], "description": "USDZ format 3D model"}, "glb": {"anyOf": [{"$ref": "#/components/schemas/File"}, {"type": "null"}], "description": "GLB format 3D model"}}, "description": "3D model files in various formats", "title": "ModelUrls", "type": "object", "x-fal-order-properties": ["glb", "fbx", "obj", "usdz", "blend", "stl"]}}}, "paths": {"/meshy/v7/retexture/requests/{request_id}/status": {"get": {"parameters": [{"name": "request_id", "in": "path", "required": true, "schema": {"type": "string", "description": "Request ID"}}, {"name": "logs", "in": "query", "required": false, "schema": {"type": "number", "description": "Whether to include logs (`1`) in the response or not (`0`)."}}], "responses": {"200": {"description": "The request status.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/QueueStatus"}}}}}}}, "/meshy/v7/retexture/requests/{request_id}/cancel": {"put": {"parameters": [{"name": "request_id", "in": "path", "required": true, "schema": {"type": "string", "description": "Request ID"}}], "responses": {"200": {"description": "The request was cancelled.", "content": {"application/json": {"schema": {"type": "object", "properties": {"success": {"type": "boolean", "description": "Whether the request was cancelled successfully."}}}}}}}}}, "/meshy/v7/retexture": {"post": {"requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/V7RetextureInput"}}}}, "responses": {"200": {"description": "The request status.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/QueueStatus"}}}}}}}, "/meshy/v7/retexture/requests/{request_id}": {"get": {"parameters": [{"name": "request_id", "in": "path", "required": true, "schema": {"type": "string", "description": "Request ID"}}], "responses": {"200": {"description": "Result of the request.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/V7RetextureOutput"}}}}}}}}, "servers": [{"url": "https://queue.fal.run"}], "security": [{"apiKeyAuth": []}]}