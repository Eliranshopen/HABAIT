{"openapi": "3.1.0", "info": {"title": "Queue OpenAPI for tripo3d/h3.1/multiview-to-3d", "version": "1.0.0", "description": "The OpenAPI schema for the tripo3d/h3.1/multiview-to-3d queue.", "x-fal-metadata": {"endpointId": "tripo3d/h3.1/multiview-to-3d", "category": "image-to-3d", "thumbnailUrl": "https://v3b.fal.media/files/b/0a95559a/U1mXxU33GmFb4hpddFBT9_ebaf264db7864aa38096b36738fd4c8c.jpg", "playgroundUrl": "https://fal.ai/models/tripo3d/h3.1/multiview-to-3d", "documentationUrl": "https://fal.ai/models/tripo3d/h3.1/multiview-to-3d/api", "about": "H31 Multiview To 3D"}}, "components": {"securitySchemes": {"apiKeyAuth": {"type": "apiKey", "in": "header", "name": "Authorization", "description": "Fal Key"}}, "schemas": {"QueueStatus": {"type": "object", "properties": {"status": {"type": "string", "enum": ["IN_QUEUE", "IN_PROGRESS", "COMPLETED"]}, "request_id": {"type": "string", "description": "The request id."}, "response_url": {"type": "string", "description": "The response url."}, "status_url": {"type": "string", "description": "The status url."}, "cancel_url": {"type": "string", "description": "The cancel url."}, "logs": {"type": "object", "description": "The logs.", "additionalProperties": true}, "metrics": {"type": "object", "description": "The metrics.", "additionalProperties": true}, "queue_position": {"type": "integer", "description": "The queue position."}}, "required": ["status", "request_id"]}, "H31MultiviewTo3dInput": {"description": "Input for Multiview to 3D generation using full-featured models (H3.1, v2.5).\n\nProvide 2-4 images of the same object from different angles.\nImages should be in order: [front, left, back, right].\nFront view is required; others are optional.\nNote: P1 is not available for multiview-to-3d.", "title": "FullMultiviewTo3DInput", "required": ["image_urls"], "properties": {"texture_seed": {"title": "Texture Seed", "anyOf": [{"type": "integer"}, {"type": "null"}], "description": "Seed for texture generation reproducibility."}, "model_seed": {"title": "Model Seed", "anyOf": [{"type": "integer"}, {"type": "null"}], "description": "Seed for geometry generation reproducibility."}, "geometry_quality": {"enum": ["standard", "detailed"], "description": "Quality level for geometry.", "title": "Geometry Quality", "type": "string", "default": "standard"}, "texture_quality": {"enum": ["standard", "detailed"], "description": "Quality level for textures.", "title": "Texture Quality", "type": "string", "default": "standard"}, "quad": {"description": "Generate quad (4-sided) mesh topology instead of triangles. When Tripo emits FBX bytes for quad output, the returned model file is FBX.", "title": "Quad", "type": "boolean", "default": false}, "texture": {"description": "Whether to generate textures for the model.", "title": "Texture", "type": "boolean", "default": true}, "auto_size": {"description": "Auto-scale the model to real-world dimensions (meters).", "title": "Auto Size", "type": "boolean", "default": false}, "orientation": {"enum": ["default", "align_image"], "description": "Model orientation.", "title": "Orientation", "type": "string", "default": "default"}, "image_urls": {"examples": [["https://v3b.fal.media/files/b/zebra/3osHJDI8IZ2wl6sGtEUeB_image.png", "https://v3b.fal.media/files/b/zebra/3osHJDI8IZ2wl6sGtEUeB_image.png"]], "minItems": 2, "title": "Image Urls", "type": "array", "items": {"type": "string"}, "description": "2 to 4 image URLs of the same object from different angles. Order: [front, left, back, right]. Front view is required.", "maxItems": 4}, "texture_alignment": {"enum": ["original_image", "geometry"], "description": "How textures are aligned.", "title": "Texture Alignment", "type": "string", "default": "original_image"}, "enable_safety_checker": {"description": "Authorized callers may set false to request relaxed screening.", "title": "Enable Safety Checker", "type": "boolean", "default": true}, "face_limit": {"title": "Face Limit", "anyOf": [{"maximum": 2000000, "type": "integer", "minimum": 1000}, {"type": "null"}], "description": "Target number of faces for the generated mesh. If not set, the model adaptively determines the count."}, "pbr": {"description": "Whether to generate PBR (Physically Based Rendering) materials. If true, texture is also enabled.", "title": "Pbr", "type": "boolean", "default": true}}, "type": "object", "x-fal-order-properties": ["image_urls", "face_limit", "texture", "pbr", "model_seed", "texture_seed", "texture_quality", "geometry_quality", "texture_alignment", "auto_size", "orientation", "quad", "enable_safety_checker"]}, "H31MultiviewTo3dOutput": {"description": "Output for Tripo3D generation", "title": "Tripo3DOutput", "required": ["model_mesh", "model_urls"], "properties": {"rendered_image": {"anyOf": [{"$ref": "#/components/schemas/File"}, {"type": "null"}], "description": "Preview render of the generated 3D model."}, "model_urls": {"title": "Model URLs", "$ref": "#/components/schemas/ModelUrls", "description": "URLs for different 3D model variants."}, "task_id": {"title": "Task Id", "anyOf": [{"type": "string"}, {"type": "null"}], "description": "Tripo task ID for a generated model. Pass this to rig or rig-check to use the model without uploading it again."}, "model_mesh": {"$ref": "#/components/schemas/File", "description": "Generated 3D model file. May be GLB or FBX depending on Tripo output."}}, "type": "object", "x-fal-order-properties": ["model_mesh", "model_urls", "rendered_image", "task_id"]}, "File": {"title": "File", "required": ["url"], "properties": {"content_type": {"examples": ["image/png"], "title": "Content Type", "anyOf": [{"type": "string"}, {"type": "null"}], "description": "The mime type of the file."}, "file_size": {"examples": [4404019], "title": "File Size", "anyOf": [{"type": "integer"}, {"type": "null"}], "description": "The size of the file in bytes."}, "file_name": {"examples": ["z9RV14K95DvU.png"], "title": "File Name", "anyOf": [{"type": "string"}, {"type": "null"}], "description": "The name of the file. It will be auto-generated if not provided."}, "url": {"title": "Url", "type": "string", "description": "The URL where the file can be downloaded from."}}, "type": "object", "x-fal-order-properties": ["url", "content_type", "file_name", "file_size"]}, "ModelUrls": {"description": "3D model download URLs", "title": "ModelUrls", "properties": {"fbx": {"title": "FBX", "anyOf": [{"$ref": "#/components/schemas/File"}, {"type": "null"}], "description": "FBX format 3D model"}, "pbr_model": {"title": "PBR Model", "anyOf": [{"$ref": "#/components/schemas/File"}, {"type": "null"}], "description": "PBR-textured model"}, "base_model": {"anyOf": [{"$ref": "#/components/schemas/File"}, {"type": "null"}], "description": "Base (untextured) model"}, "glb": {"title": "GLB", "anyOf": [{"$ref": "#/components/schemas/File"}, {"type": "null"}], "description": "GLB format 3D model"}}, "type": "object", "x-fal-order-properties": ["glb", "fbx", "base_model", "pbr_model"]}}}, "paths": {"/tripo3d/h3.1/multiview-to-3d/requests/{request_id}/status": {"get": {"parameters": [{"name": "request_id", "in": "path", "required": true, "schema": {"type": "string", "description": "Request ID"}}, {"name": "logs", "in": "query", "required": false, "schema": {"type": "number", "description": "Whether to include logs (`1`) in the response or not (`0`)."}}], "responses": {"200": {"description": "The request status.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/QueueStatus"}}}}}}}, "/tripo3d/h3.1/multiview-to-3d/requests/{request_id}/cancel": {"put": {"parameters": [{"name": "request_id", "in": "path", "required": true, "schema": {"type": "string", "description": "Request ID"}}], "responses": {"200": {"description": "The request was cancelled.", "content": {"application/json": {"schema": {"type": "object", "properties": {"success": {"type": "boolean", "description": "Whether the request was cancelled successfully."}}}}}}}}}, "/tripo3d/h3.1/multiview-to-3d": {"post": {"requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/H31MultiviewTo3dInput"}}}}, "responses": {"200": {"description": "The request status.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/QueueStatus"}}}}}}}, "/tripo3d/h3.1/multiview-to-3d/requests/{request_id}": {"get": {"parameters": [{"name": "request_id", "in": "path", "required": true, "schema": {"type": "string", "description": "Request ID"}}], "responses": {"200": {"description": "Result of the request.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/H31MultiviewTo3dOutput"}}}}}}}}, "servers": [{"url": "https://queue.fal.run"}], "security": [{"apiKeyAuth": []}]}