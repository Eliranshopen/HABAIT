{"openapi": "3.1.0", "info": {"title": "Queue OpenAPI for tripo3d/p2/image-to-3d", "version": "1.0.0", "description": "The OpenAPI schema for the tripo3d/p2/image-to-3d queue.", "x-fal-metadata": {"endpointId": "tripo3d/p2/image-to-3d", "category": "image-to-3d", "thumbnailUrl": "https://v3b.fal.media/files/b/0aab5c22/iR7ETXMnNL1Kgpj5bWU5k.jpg", "playgroundUrl": "https://fal.ai/models/tripo3d/p2/image-to-3d", "documentationUrl": "https://fal.ai/models/tripo3d/p2/image-to-3d/api", "about": "P2 Image To 3D"}}, "components": {"securitySchemes": {"apiKeyAuth": {"type": "apiKey", "in": "header", "name": "Authorization", "description": "Fal Key"}}, "schemas": {"QueueStatus": {"type": "object", "properties": {"status": {"type": "string", "enum": ["IN_QUEUE", "IN_PROGRESS", "COMPLETED"]}, "request_id": {"type": "string", "description": "The request id."}, "response_url": {"type": "string", "description": "The response url."}, "status_url": {"type": "string", "description": "The status url."}, "cancel_url": {"type": "string", "description": "The cancel url."}, "logs": {"type": "object", "description": "The logs.", "additionalProperties": true}, "metrics": {"type": "object", "description": "The metrics.", "additionalProperties": true}, "queue_position": {"type": "integer", "description": "The queue position."}}, "required": ["status", "request_id"]}, "P2ImageTo3dInput": {"description": "Input for Image to 3D generation using the P2 model.", "title": "P2ImageTo3DInput", "required": ["image_url"], "properties": {"image_url": {"examples": ["https://v3b.fal.media/files/b/zebra/3osHJDI8IZ2wl6sGtEUeB_image.png"], "title": "Image Url", "type": "string", "description": "URL of the input image for 3D model creation."}, "model_seed": {"title": "Model Seed", "anyOf": [{"type": "integer"}, {"type": "null"}], "description": "Seed for geometry generation reproducibility."}, "texture_seed": {"title": "Texture Seed", "anyOf": [{"type": "integer"}, {"type": "null"}], "description": "Seed for texture generation reproducibility."}, "texture_quality": {"enum": ["fast", "standard", "detailed", "extreme"], "description": "Texture quality level.", "title": "Texture Quality", "type": "string", "default": "standard"}, "quad": {"description": "Generate quad mesh topology instead of triangles.", "title": "Quad", "type": "boolean", "default": false}, "texture": {"description": "Whether to generate textures for the model.", "title": "Texture", "type": "boolean", "default": true}, "auto_size": {"description": "Auto-scale the model to real-world dimensions in meters.", "title": "Auto Size", "type": "boolean", "default": false}, "delight": {"description": "Remove baked-in lighting before texturing with v3.5-20260815.", "title": "Delight", "type": "boolean", "default": true}, "export_uv": {"description": "Whether to generate UV coordinates for the model.", "title": "Export Uv", "type": "boolean", "default": true}, "texture_version": {"title": "Texture Version", "anyOf": [{"type": "string", "enum": ["v3.5-20260815", "v3.0-20250812", "v2.5-20250123"]}, {"type": "null"}], "description": "Texture model version. The fast quality requires v3.5-20260815."}, "export_orientation": {"title": "Export Orientation", "anyOf": [{"type": "string", "enum": ["+x", "-x", "-y", "+y"]}, {"type": "null"}], "description": "Optional forward axis for the exported model."}, "enable_safety_checker": {"description": "Authorized callers may set false to request relaxed screening.", "title": "Enable Safety Checker", "type": "boolean", "default": true}, "face_limit": {"title": "Face Limit", "anyOf": [{"maximum": 50000, "type": "integer", "minimum": 48}, {"type": "null"}], "description": "Maximum number of faces for the generated mesh. Quad meshes support up to 25,000 faces."}, "pbr": {"description": "Whether to generate PBR material maps. Enabling PBR also enables textures.", "title": "Pbr", "type": "boolean", "default": true}}, "type": "object", "x-fal-order-properties": ["image_url", "face_limit", "texture", "pbr", "model_seed", "texture_seed", "texture_quality", "texture_version", "delight", "auto_size", "export_uv", "export_orientation", "quad", "enable_safety_checker"]}, "P2ImageTo3dOutput": {"description": "Output for Tripo3D generation", "title": "Tripo3DOutput", "required": ["model_mesh", "model_urls"], "properties": {"rendered_image": {"anyOf": [{"$ref": "#/components/schemas/File"}, {"type": "null"}], "description": "Preview render of the generated 3D model."}, "model_urls": {"title": "Model URLs", "$ref": "#/components/schemas/ModelUrls", "description": "URLs for different 3D model variants."}, "task_id": {"title": "Task Id", "anyOf": [{"type": "string"}, {"type": "null"}], "description": "Tripo task ID for a generated model. Pass this to rig or rig-check to use the model without uploading it again."}, "model_mesh": {"$ref": "#/components/schemas/File", "description": "Generated 3D model file. May be GLB or FBX depending on Tripo output."}}, "type": "object", "x-fal-order-properties": ["model_mesh", "model_urls", "rendered_image", "task_id"]}, "File": {"title": "File", "required": ["url"], "properties": {"content_type": {"examples": ["image/png"], "title": "Content Type", "anyOf": [{"type": "string"}, {"type": "null"}], "description": "The mime type of the file."}, "file_size": {"examples": [4404019], "title": "File Size", "anyOf": [{"type": "integer"}, {"type": "null"}], "description": "The size of the file in bytes."}, "file_name": {"examples": ["z9RV14K95DvU.png"], "title": "File Name", "anyOf": [{"type": "string"}, {"type": "null"}], "description": "The name of the file. It will be auto-generated if not provided."}, "url": {"title": "Url", "type": "string", "description": "The URL where the file can be downloaded from."}}, "type": "object", "x-fal-order-properties": ["url", "content_type", "file_name", "file_size"]}, "ModelUrls": {"description": "3D model download URLs", "title": "ModelUrls", "properties": {"fbx": {"title": "FBX", "anyOf": [{"$ref": "#/components/schemas/File"}, {"type": "null"}], "description": "FBX format 3D model"}, "pbr_model": {"title": "PBR Model", "anyOf": [{"$ref": "#/components/schemas/File"}, {"type": "null"}], "description": "PBR-textured model"}, "base_model": {"anyOf": [{"$ref": "#/components/schemas/File"}, {"type": "null"}], "description": "Base (untextured) model"}, "glb": {"title": "GLB", "anyOf": [{"$ref": "#/components/schemas/File"}, {"type": "null"}], "description": "GLB format 3D model"}}, "type": "object", "x-fal-order-properties": ["glb", "fbx", "base_model", "pbr_model"]}}}, "paths": {"/tripo3d/p2/image-to-3d/requests/{request_id}/status": {"get": {"parameters": [{"name": "request_id", "in": "path", "required": true, "schema": {"type": "string", "description": "Request ID"}}, {"name": "logs", "in": "query", "required": false, "schema": {"type": "number", "description": "Whether to include logs (`1`) in the response or not (`0`)."}}], "responses": {"200": {"description": "The request status.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/QueueStatus"}}}}}}}, "/tripo3d/p2/image-to-3d/requests/{request_id}/cancel": {"put": {"parameters": [{"name": "request_id", "in": "path", "required": true, "schema": {"type": "string", "description": "Request ID"}}], "responses": {"200": {"description": "The request was cancelled.", "content": {"application/json": {"schema": {"type": "object", "properties": {"success": {"type": "boolean", "description": "Whether the request was cancelled successfully."}}}}}}}}}, "/tripo3d/p2/image-to-3d": {"post": {"requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/P2ImageTo3dInput"}}}}, "responses": {"200": {"description": "The request status.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/QueueStatus"}}}}}}}, "/tripo3d/p2/image-to-3d/requests/{request_id}": {"get": {"parameters": [{"name": "request_id", "in": "path", "required": true,