{"openapi": "3.1.0", "info": {"title": "Queue OpenAPI for tripo3d/tripo/remesh", "version": "1.0.0", "description": "The OpenAPI schema for the tripo3d/tripo/remesh queue.", "x-fal-metadata": {"endpointId": "tripo3d/tripo/remesh", "category": "3d-to-3d", "thumbnailUrl": "https://v3b.fal.media/files/b/0aa54846/p3ydtPbP_CPp-9oWvXwzk.jpg", "playgroundUrl": "https://fal.ai/models/tripo3d/tripo/remesh", "documentationUrl": "https://fal.ai/models/tripo3d/tripo/remesh/api", "about": "Remesh"}}, "components": {"securitySchemes": {"apiKeyAuth": {"type": "apiKey", "in": "header", "name": "Authorization", "description": "Fal Key"}}, "schemas": {"QueueStatus": {"type": "object", "properties": {"status": {"type": "string", "enum": ["IN_QUEUE", "IN_PROGRESS", "COMPLETED"]}, "request_id": {"type": "string", "description": "The request id."}, "response_url": {"type": "string", "description": "The response url."}, "status_url": {"type": "string", "description": "The status url."}, "cancel_url": {"type": "string", "description": "The cancel url."}, "logs": {"type": "object", "description": "The logs.", "additionalProperties": true}, "metrics": {"type": "object", "description": "The metrics.", "additionalProperties": true}, "queue_position": {"type": "integer", "description": "The queue position."}}, "required": ["status", "request_id"]}, "TripoRemeshInput": {"description": "Input for the Smart low poly / remesh (``highpoly_to_lowpoly``) task.\n\nRetopologises a high-poly 3D model into a clean, lower-poly mesh. The input\nmodel is imported into Tripo first (``import_model``), then remeshed.", "title": "RemeshInput", "required": ["mesh_url"], "properties": {"part_names": {"title": "Part Names", "anyOf": [{"items": {"type": "string"}, "type": "array"}, {"type": "null"}], "description": "Optional list of part names (as returned by a prior mesh segmentation) to preserve as separate parts while remeshing."}, "face_limit": {"title": "Face Limit", "anyOf": [{"maximum": 20000, "type": "integer", "minimum": 500}, {"type": "null"}], "description": "Target face count of the remeshed model. Range 500-20000 (500-10000 when 'quad' is true). If unset, the model determines the count adaptively."}, "quad": {"description": "Generate quad (4-sided) mesh topology instead of triangles. Forces FBX output. When enabled and 'face_limit' is unset, 'face_limit' defaults to 10000.", "title": "Quad", "type": "boolean", "default": false}, "bake": {"description": "Bake textures onto the remeshed model during generation.", "title": "Bake", "type": "boolean", "default": true}, "mesh_url": {"examples": ["https://raw.githubusercontent.com/KhronosGroup/glTF-Sample-Models/master/2.0/DamagedHelmet/glTF-Binary/DamagedHelmet.glb"], "title": "Mesh URL", "type": "string", "description": "URL of the input 3D model to remesh. Supported formats: GLB, OBJ, FBX, STL (max 150MB)."}}, "type": "object", "x-fal-order-properties": ["mesh_url", "quad", "face_limit", "bake", "part_names"]}, "TripoRemeshOutput": {"description": "Output for Tripo3D generation", "title": "Tripo3DOutput", "required": ["model_mesh", "model_urls"], "properties": {"rendered_image": {"anyOf": [{"$ref": "#/components/schemas/File"}, {"type": "null"}], "description": "Preview render of the generated 3D model."}, "model_urls": {"title": "Model URLs", "$ref": "#/components/schemas/ModelUrls", "description": "URLs for different 3D model variants."}, "task_id": {"title": "Task Id", "anyOf": [{"type": "string"}, {"type": "null"}], "description": "Tripo task ID for a generated model. Pass this to rig or rig-check to use the model without uploading it again."}, "model_mesh": {"$ref": "#/components/schemas/File", "description": "Generated 3D model file. May be GLB or FBX depending on Tripo output."}}, "type": "object", "x-fal-order-properties": ["model_mesh", "model_urls", "rendered_image", "task_id"]}, "File": {"title": "File", "required": ["url"], "properties": {"content_type": {"examples": ["image/png"], "title": "Content Type", "anyOf": [{"type": "string"}, {"type": "null"}], "description": "The mime type of the file."}, "file_size": {"examples": [4404019], "title": "File Size", "anyOf": [{"type": "integer"}, {"type": "null"}], "description": "The size of the file in bytes."}, "file_name": {"examples": ["z9RV14K95DvU.png"], "title": "File Name", "anyOf": [{"type": "string"}, {"type": "null"}], "description": "The name of the file. It will be auto-generated if not provided."}, "url": {"title": "Url", "type": "string", "description": "The URL where the file can be downloaded from."}}, "type": "object", "x-fal-order-properties": ["url", "content_type", "file_name", "file_size"]}, "ModelUrls": {"description": "3D model download URLs", "title": "ModelUrls", "properties": {"fbx": {"title": "FBX", "anyOf": [{"$ref": "#/components/schemas/File"}, {"type": "null"}], "description": "FBX format 3D model"}, "pbr_model": {"title": "PBR Model", "anyOf": [{"$ref": "#/components/schemas/File"}, {"type": "null"}], "description": "PBR-textured model"}, "base_model": {"anyOf": [{"$ref": "#/components/schemas/File"}, {"type": "null"}], "description": "Base (untextured) model"}, "glb": {"title": "GLB", "anyOf": [{"$ref": "#/components/schemas/File"}, {"type": "null"}], "description": "GLB format 3D model"}}, "type": "object", "x-fal-order-properties": ["glb", "fbx", "base_model", "pbr_model"]}}}, "paths": {"/tripo3d/tripo/remesh/requests/{request_id}/status": {"get": {"parameters": [{"name": "request_id", "in": "path", "required": true, "schema": {"type": "string", "description": "Request ID"}}, {"name": "logs", "in": "query", "required": false, "schema": {"type": "number", "description": "Whether to include logs (`1`) in the response or not (`0`)."}}], "responses": {"200": {"description": "The request status.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/QueueStatus"}}}}}}}, "/tripo3d/tripo/remesh/requests/{request_id}/cancel": {"put": {"parameters": [{"name": "request_id", "in": "path", "required": true, "schema": {"type": "string", "description": "Request ID"}}], "responses": {"200": {"description": "The request was cancelled.", "content": {"application/json": {"schema": {"type": "object", "properties": {"success": {"type": "boolean", "description": "Whether the request was cancelled successfully."}}}}}}}}}, "/tripo3d/tripo/remesh": {"post": {"requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TripoRemeshInput"}}}}, "responses": {"200": {"description": "The request status.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/QueueStatus"}}}}}}}, "/tripo3d/tripo/remesh/requests/{request_id}": {"get": {"parameters": [{"name": "request_id", "in": "path", "required": true, "schema": {"type": "string", "description": "Request ID"}}], "responses": {"200": {"description": "Result of the request.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TripoRemeshOutput"}}}}}}}}, "servers": [{"url": "https://queue.fal.run"}], "security": [{"apiKeyAuth": []}]}