{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "habait/platform/flow.v0",
  "title": "flow.json v0 - the scripted 360 flight of one project as a chain of segments",
  "type": "object",
  "required": ["project", "start", "segments"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "project": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "start": { "type": "string", "description": "id of the first segment" },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "description": "segments used when a unit has no descend-<id> / enter-<id> of its own (placeholder flights)",
      "properties": {
        "descend": { "type": "string" },
        "enter": { "type": "string" }
      }
    },
    "segments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/segment" } }
  },
  "$defs": {
    "segment": {
      "type": "object",
      "required": ["id", "kind", "src", "duration_s", "next"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "description": "approach | orbit | hold-facade | descend-<unit> | enter-<unit> | ..." },
        "kind": { "type": "string", "enum": ["video", "still"] },
        "src": { "type": "string", "minLength": 1, "description": "path relative to the project folder; equirectangular 2:1 (mp4 for video, png/jpg/webp for still)" },
        "poster": { "type": "string", "description": "optional still shown while the video buffers" },
        "duration_s": { "type": "number", "exclusiveMinimum": 0 },
        "loop": { "type": "boolean", "default": false, "description": "stay on this segment (looping) until the buyer acts; hotspots stay clickable" },
        "role": { "type": "string", "enum": ["approach", "orbit", "hold", "descend", "enter"], "description": "what the segment is in the story; hold = apartments are clickable" },
        "unit": { "type": "string", "description": "for descend/enter: the unit this segment belongs to" },
        "title": { "$ref": "#/$defs/i18n" },
        "hotspots": {
          "type": "array",
          "description": "navigational hotspots of the segment itself (not units): e.g. 'skip to facade'",
          "items": {
            "type": "object",
            "required": ["id", "t_start", "t_end", "yaw_deg", "pitch_deg", "action"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "t_start": { "type": "number", "minimum": 0 },
              "t_end": { "type": "number", "minimum": 0 },
              "yaw_deg": { "type": "number", "minimum": -180, "maximum": 180 },
              "pitch_deg": { "type": "number", "minimum": -90, "maximum": 90 },
              "label": { "$ref": "#/$defs/i18n" },
              "action": {
                "type": "object",
                "required": ["type"],
                "additionalProperties": false,
                "properties": {
                  "type": { "type": "string", "enum": ["goto", "continue"] },
                  "segment": { "type": "string" }
                }
              }
            }
          }
        },
        "next": {
          "description": "what happens when the segment ends: a segment id, 'handoff' (open the unit's tour_url), 'end', or null (stay)",
          "oneOf": [
            { "type": "string" },
            { "type": "null" }
          ]
        }
      }
    },
    "i18n": {
      "type": "object",
      "required": ["he", "en"],
      "properties": { "he": { "type": "string" }, "en": { "type": "string" } },
      "additionalProperties": { "type": "string" }
    }
  }
}
