ture Quality"},"model_seed":{"title":"Model Seed","description":"Seed for geometry generation reproducibility.","anyOf":[{"type":"integer"},{"type":"null"}]},"texture_seed":{"title":"Texture Seed","description":"Seed for texture generation reproducibility.","anyOf":[{"type":"integer"},{"type":"null"}]}},"required":["image_urls"]},"H31MultiviewTo3dOutput":{"title":"Tripo3DOutput","type":"object","description":"Output for Tripo3D generation","x-fal-order-properties":["model_mesh","model_urls","rendered_image","task_id"],"properties":{"task_id":{"title":"Task Id","description":"Tripo task ID for a generated model. Pass this to rig or rig-check to use the model without uploading it again.","anyOf":[{"type":"string"},{"type":"null"}]},"model_mesh":{"$ref":"#/components/schemas/File","description":"Generated 3D model file. May be GLB or FBX depending on Tripo output."},"model_urls":{"title":"Model URLs","$ref":"#/components/schemas/ModelUrls","description":"URLs for different 3D model variants."},"rendered_image":{"description":"Preview render of the generated 3D model.","anyOf":[{"$ref":"#/components/schemas/File"},{"type":"null"}]}},"required":["model_mesh","model_urls"]},"File":{"title":"File","type":"object","x-fal-order-properties":["url","content_type","file_name","file_size"],"properties":{"file_name":{"title":"File Name","examples":["z9RV14K95DvU.png"],"description":"The name of the file. It will be auto-generated if not provided.","anyOf":[{"type":"string"},{"type":"null"}]},"file_size":{"title":"File Size","examples":[4404019],"description":"The size of the file in bytes.","anyOf":[{"type":"integer"},{"type":"null"}]},"content_type":{"title":"Content Type","examples":["image/png"],"description":"The mime type of the file.","anyOf":[{"type":"string"},{"type":"null"}]},"url":{"title":"Url","type":"string","description":"The URL where the file can be downloaded from."}},"required":["url"]},"ModelUrls":{"title":"ModelUrls","type":"object","description":"3D model dow